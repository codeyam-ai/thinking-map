// Prisma 7 with PostgreSQL via the `pg` driver adapter.
//
// IMPORTANT: Use "prisma-client-js" (NOT "prisma-client").
// The "prisma-client" generator requires a custom output path which
// breaks Turbopack import resolution and seed script imports.
// "prisma-client-js" outputs to node_modules/@prisma/client which
// works everywhere with standard imports.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ──────────────────────────────────────────────
// Thinking Map
//
// Three models carry the whole product. A ThinkingMap is one session of
// thinking; Messages are the conversation view of it; MapNodes are the
// visual view of the same thinking. The conversation and the map are two
// renderings of one process, so they hang off the same root.
//
// `kind`, `phase`, and `status` are Strings. This began as a SQLite
// constraint — Prisma has no enum support there — but it is now a
// deliberate choice, kept when the datasource moved to PostgreSQL. Their
// allowed values live in app/lib/mapKinds.ts, which is the single place
// they are defined, and native enums would split that definition in two
// and make every added value a migration.
// ──────────────────────────────────────────────

model ThinkingMap {
  id       String @id @default(cuid())
  /// Short label for the map, shown when returning to a saved session.
  title    String
  /// The user's original unstructured input, preserved verbatim. Even after
  /// the direction changes, the seed idea is never overwritten.
  seedIdea String
  /// Which stage of the loop this map has reached:
  /// idea | deconstruct | map | research | explore | next-steps
  phase    String @default("idea")
  /// LEGACY. What the person attached, as JSON: [{ name }] — names and nothing
  /// else. Superseded by the `attachments` relation below, which holds the file
  /// itself, and read only by the one-off backfill in `prisma/backfill-attachments.ts`.
  /// Kept for exactly as long as it takes an existing database to run that
  /// backfill; nothing in the app reads it. `@map` holds the underlying column
  /// name still — the rename is in Prisma only, so no existing row moves and
  /// the backfill has something to read.
  attachmentsJson String? @map("attachments")
  /// Monotonic change counter, bumped once per committed change in the same
  /// transaction as the write. This is the cursor an agent reads with, and the
  /// only shared notion of "now" across all three front doors. It is a column
  /// rather than an in-memory counter precisely because the stdio MCP server
  /// runs in a different process from Next — a process-local counter would
  /// hand two front doors two different answers.
  revision Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]
  nodes    MapNode[]
  themes   Theme[]
  events   MapEvent[]
  brief    MapBrief?

  attachments MapAttachment[]
}

// ──────────────────────────────────────────────
// What the person brought along
//
// A whiteboard photo, a screenshot of the flow being replaced, a diagram
// somebody sketched. These are briefs too — and until this model existed the
// board could only record that one HAD been attached. A filename an agent
// cannot open is not a contribution to the thinking.
//
// This reverses the position the `attachments` column above used to state in as
// many words: names, not bytes, because storing the file was "a different
// product with a different set of problems (size, privacy, expiry)". Those
// three problems are real, and each is answered here rather than waived:
//
//   size    — hard server-side caps, enforced in the upload route: 5MB per
//             attachment, 4 per map, 10MB per map in total. A cap only the
//             client enforces is not a cap.
//   privacy — the bytes live in this same SQLite file as everything else, so
//             one dev.db is still the whole state, backup and teardown story.
//             Nothing is written to a directory nobody is serving.
//   expiry  — the cascade below. Deleting a map really deletes what came with
//             it, with no orphaned file left behind to expire.
//
// What changed to make the reversal worth it: an agent with vision can read a
// diagram. `read_attachment` is the point of the whole model.
//
// Its own model rather than a wider JSON column because base64 image data does
// not belong in a column whose contract (see `app/lib/attachments.ts`) is that
// a board must still open when the column is garbage — and because a
// per-attachment id is what both the byte-serving route and `read_attachment`
// address a single file by.
// ──────────────────────────────────────────────

model MapAttachment {
  id    String      @id @default(cuid())
  mapId String
  map   ThinkingMap @relation(fields: [mapId], references: [id], onDelete: Cascade)

  /// The filename as it arrived. This is what the board shows and what the
  /// agent is told it is looking at.
  name      String
  /// What kind of file it is, so a reader can decide whether it can be looked
  /// at without sniffing the bytes.
  mediaType String
  /// The file itself. NULLABLE, and permanently so: every attachment recorded
  /// before this model existed migrates as a row with no bytes rather than
  /// being dropped. Such a row renders on the board exactly as it always did
  /// and simply has nothing to look at — which `read_attachment` says plainly.
  bytes     Bytes?
  /// Denormalised length, so the per-map total can be summed and the strip can
  /// state a size without the bytes being read. Zero for a legacy row.
  byteSize  Int         @default(0)

  createdAt DateTime @default(now())

  @@index([mapId])
}

// ──────────────────────────────────────────────
// Themes — the galaxies
//
// A theme is a group of questions that belong together ("Context", "Who it is
// for"). Themes are NOT a fixed vocabulary: which groupings an idea falls into
// is a property of that idea, so the agent names them as it discovers them.
//
// The hue is the exception. The agent supplies a label and the app assigns the
// colour, because colour is the navigation affordance on the board — you find
// your way around the galaxy by it — and that only works if the hues stay
// mutually distinguishable however many themes appear. Left to a model, two
// consecutive themes eventually land on two neighbouring blues.
// ──────────────────────────────────────────────

model Theme {
  id    String      @id @default(cuid())
  mapId String
  map   ThinkingMap @relation(fields: [mapId], references: [id], onDelete: Cascade)
  /// What the agent called this galaxy. Free text, shown as the cluster label.
  label String
  /// 0–359, assigned by the app on the golden angle. See app/lib/themeHue.ts.
  hue   Int
  /// Position among sibling themes, which is also the order they were opened.
  order Int         @default(0)

  createdAt DateTime @default(now())

  nodes MapNode[]

  @@index([mapId])
}

model Message {
  id      String      @id @default(cuid())
  mapId   String
  map     ThinkingMap @relation(fields: [mapId], references: [id], onDelete: Cascade)
  /// user | assistant
  role    String
  /// user | agent — who actually produced this turn. Distinct from `role`,
  /// which is the chat transcript position the model sees.
  origin  String @default("agent")
  content String

  createdAt DateTime @default(now())

  @@index([mapId])
}

model MapNode {
  id       String      @id @default(cuid())
  mapId    String
  map      ThinkingMap @relation(fields: [mapId], references: [id], onDelete: Cascade)
  /// Null for the root idea node. The map is a tree, so parentage is the
  /// only edge we need to store.
  parentId String?
  parent   MapNode?    @relation("NodeChildren", fields: [parentId], references: [id])
  children MapNode[]   @relation("NodeChildren")

  /// What this node represents. One of:
  /// idea | user | problem | goal | constraint | assumption | open-question
  /// | research | finding | gap | approach | pro | risk
  /// | known | unknown | direction | next-step | slice
  /// | suggestion | experiment
  kind      String
  /// The short text shown inside the node pill.
  label     String
  /// Longer supporting text, shown when the node is inspected. For an answered
  /// question this is what the person said.
  detail    String?
  /// For a question: the options offered, as a JSON array of strings. Null
  /// means the question is open-ended. Stored as JSON rather than as a relation
  /// because choices have no identity of their own — they are part of how one
  /// question is phrased, and nothing ever needs to link to a single option.
  choices   String?
  /// open | answered | updated — drives the dashed / solid / highlighted
  /// node treatment in the mockups.
  status    String  @default("open")
  /// Where a research finding came from, when this node is a finding.
  sourceUrl String?
  /// A picture to show on the card: a screenshot of an existing product, a
  /// sketch, a diagram the partner drew. Held as a URL rather than as bytes
  /// because the map is a place to point AT things, not a place to store them —
  /// and a node the agent can write with one string is a node it will actually
  /// use.
  imageUrl  String?
  /// What the picture is, for anyone who cannot see it.
  imageAlt  String?
  /// A small diagram the partner drew, as JSON: { steps: [...], note? }.
  /// Declarative rather than markup on purpose — see app/lib/diagram.ts.
  diagram   String?
  /// The id of the node this slice would settle — the assumption, risk, or
  /// open question that building it would answer. A slice that names nothing
  /// is not a validating increment, just work scheduled early, and the summary
  /// screen says so rather than letting it pass as progress.
  ///
  /// Deliberately NOT a Prisma relation. `parentId` is the map's only edge, and
  /// a second self-relation would either collide with NodeChildren's semantics
  /// or drag every tested assumption out of where it belongs in the tree and
  /// into a branch under the plan. This is a pointer that is resolved in code
  /// and never drawn. A dangling id is tolerated and reported: the node it
  /// names may since have been deleted.
  testsNodeId String?
  /// The brief section id this node was derived from (e.g. `s7`), when the map
  /// has a brief and this claim came from one identifiable part of it.
  ///
  /// The deliberate contrast with `sourceUrl` directly above: `sourceUrl` points
  /// OUT of the map at the web, `sourceRef` points INTO the client's own
  /// document. Overloading one column for both would make the research card's
  /// link rendering wrong for half of its values.
  ///
  /// It is also the contrast with `testsNodeId` directly above: that points at
  /// another NODE on this map, while this points at a passage in the document
  /// the map came from. Both are pointers resolved in code rather than drawn.
  ///
  /// Stores the section id, never the quoted passage. Sections are derived on
  /// demand by `app/lib/briefSections.ts` from brief text that is written once
  /// and never updated, so the reference cannot drift from what it points at —
  /// whereas a copy of the passage kept here could.
  ///
  /// Optional, and always will be: a node the person typed, or one the agent
  /// inferred across the whole document, has no single source section. Forcing
  /// one would produce fabricated citations, which is worse than none.
  sourceRef String?
  /// The nodes this insight was drawn OUT of, as a JSON array of node ids —
  /// the questions, answers and findings behind a claim. It is what lets the
  /// person see the thinking behind an insight instead of taking it on trust.
  ///
  /// A pointer resolved in code, exactly as `testsNodeId` above is: not a
  /// Prisma relation, never drawn on the map, and a dangling id is tolerated
  /// because the node it names may since have been deleted.
  ///
  /// The contrast with `testsNodeId` is arity and direction. `testsNodeId`
  /// names the ONE node a slice would settle, looking FORWARD at what building
  /// would answer; this names the SEVERAL nodes an insight came out of, looking
  /// BACK at what produced it. That plurality is also why it cannot be
  /// `parentId`: the tree is the map's only edge, an insight has several
  /// sources, and hanging it off a question would drag it into that question's
  /// row when the whole point of an insight is that it belongs to none.
  ///
  /// Stored as a String because SQLite has no array type, in the manner
  /// `options` and `choices` already are on this model.
  ///
  /// Optional, and absent rather than empty: an insight drawn from the whole
  /// map genuinely has no single source, and a fabricated citation is worse
  /// than none.
  fromNodeIds String?
  /// Left-to-right position among siblings.
  order     Int     @default(0)
  /// The galaxy this node belongs to. Null for the root idea, which belongs to
  /// no theme precisely because it is what every theme orbits.
  themeId   String?
  theme     Theme?  @relation(fields: [themeId], references: [id], onDelete: SetNull)
  /// user | agent. Without this an agent re-reading the map cannot tell its
  /// own writes from the person's, and will re-ingest its own output as new
  /// information. It is also what lets the UI mark what the person contributed.
  origin    String  @default("agent")
  /// A few likely answers to offer alongside an open question, as a JSON array
  /// of strings — the chips on the question's card. Held as a String because
  /// SQLite has no array type, in the manner this schema already uses for
  /// enum-less values.
  ///
  /// Meaningful only on an `open-question`. Optional and always will be: an
  /// agent that never learned the field, and a question with no obvious
  /// shortlist, both produce a card that is simply an input — which is the
  /// ordinary case, not a degraded one.
  ///
  /// The chips fill the input rather than submitting it, so these are
  /// suggestions the person edits, never a closed set of choices. Storing them
  /// does not make the question multiple-choice.
  options   String?
  /// A nudge away from the node's computed tidy position, in layout pixels —
  /// not a position. The tidy tree stays authoritative: siblings still never
  /// overlap by default, parents still centre over their children, and a node
  /// added tomorrow still places itself sensibly instead of landing on top of
  /// something moved last week. Drop these and the map is exactly what it was.
  ///
  /// Deliberately absent from the agent's rendering of the map. `read_map`
  /// describes the thinking; pixel offsets are arrangement, and feeding an
  /// agent coordinates it cannot act on is noise in a context window better
  /// spent on the map's content.
  ///
  /// Defaulted rather than nullable so every existing row is already valid and
  /// no backfill is needed.
  ///
  /// VESTIGIAL as of the "The Map Builds Downward" plan: the map is now a
  /// scrolling column of card rows with no plane to nudge a node around on, so
  /// nothing reads these. Kept rather than dropped because dropping a column is
  /// a migration and that plan deliberately is not one.
  offsetX   Float   @default(0)
  offsetY   Float   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([mapId])
  @@index([parentId])
}

// ──────────────────────────────────────────────
// The exchange log
//
// WebMCP is pull-only: a page cannot wake an agent, and there is no push
// channel. So the give-and-take between the person and the agent has to be
// built out of a durable, ordered, resumable record that either side can read
// at any time — which is this table.
//
// One append-only log rather than three mechanisms, because the agent's
// delta, the inbox of unread user contributions, and the activity feed the UI
// renders are the same question asked three ways: "what happened after
// revision N?". It also covers node deletion, which a diff over MapNode rows
// cannot see at all.
// ──────────────────────────────────────────────

model MapEvent {
  id    String      @id @default(cuid())
  mapId String
  map   ThinkingMap @relation(fields: [mapId], references: [id], onDelete: Cascade)

  /// The map revision this event created. Ordered and gapless per map, so a
  /// reader that has seen revision N can ask for everything after it.
  revision Int
  /// node.added | node.updated | phase.set | agent.note
  /// | question.asked | user.answer | user.note | user.node
  kind     String
  /// user | agent — which side of the exchange produced this.
  origin   String
  /// Event-specific JSON. Kept as a string because SQLite has no JSON column
  /// type; the shapes live in app/lib/exchange.ts.
  payload  String
  /// Idempotency key, carried by EVERY row a single call wrote. A retried tool
  /// call with the same requestId is a no-op that returns the original batch
  /// and its last revision, rather than a duplicate write.
  ///
  /// The guarantee covers the ROWS THE CALL WROTE, not only this log. The key
  /// is checked as the first statement of the same transaction that creates
  /// the themes and nodes, so a retry adds no second copy of a card either —
  /// see `applyToolCalls` in app/lib/mapStore.ts.
  ///
  /// Keyed per row rather than per batch because the retry needs the batch's
  /// extent: with only the first row keyed, a retry hands back the first
  /// revision as the resume cursor and the agent re-reads the rest of its own
  /// batch as new information. Uniqueness therefore includes `revision` — the
  /// duplicate a retry could create is caught by the in-transaction lookup in
  /// `findPriorBatch`, which runs inside SQLite's serialized write lock.
  requestId String?

  createdAt DateTime @default(now())

  @@unique([mapId, revision])
  @@unique([mapId, requestId, revision])
  @@index([mapId, revision])
  @@index([mapId, requestId])
}

// ──────────────────────────────────────────────
// The client's brief
//
// Some maps do not start from a sentence. They start from a twenty-page spec,
// and the whole point of this model is that the document arrives WHOLE rather
// than squeezed through a one-line input.
//
// Write-once, exactly like `seedIdea`: a brief is attached when the map is
// created and never overwritten. A revised brief is a NEW map, because a v2
// spec is a different conversation — not an edit to this one. That immutability
// is load-bearing: it is what lets section ids be derived from the text by a
// pure splitter (app/lib/briefSections.ts) instead of stored as rows that would
// have to be kept in sync.
//
// Its own model rather than columns on ThinkingMap so that `listMaps` and every
// `getMap` do not drag tens of thousands of characters into memory on every
// page render. The text has exactly one reader — the agent's `read_brief` tool.
//
// Only the extracted TEXT is persisted. The .pdf or .docx it arrived in is
// packaging, and is thrown away once the words are out of it.
// ──────────────────────────────────────────────

model MapBrief {
  id    String      @id @default(cuid())
  /// Unique: one brief per map. Attaching or replacing a brief on a running
  /// map is deliberately not possible — it would need a document-version model
  /// and a story for references pointing into a passage that no longer exists.
  mapId String      @unique
  map   ThinkingMap @relation(fields: [mapId], references: [id], onDelete: Cascade)

  /// The uploaded filename, or "pasted" when the client pasted the text in.
  sourceName String
  /// The media type it arrived as, kept so a reader can say what kind of
  /// document this was without re-sniffing the text.
  mediaType  String
  /// The extracted text, verbatim beyond line-ending normalisation.
  text       String
  /// Denormalised length, so the brief can announce its own size without the
  /// text being read. This is what keeps `read_map` cheap.
  charCount  Int

  createdAt DateTime @default(now())
}
