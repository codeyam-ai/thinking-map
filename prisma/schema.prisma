// Prisma 7 with SQLite via better-sqlite3 driver adapter.
//
// IMPORTANT: Use "prisma-client-js" (NOT "prisma-client").
// The "prisma-client" generator requires a custom output path which
// breaks Turbopack import resolution and seed script imports.
// "prisma-client-js" outputs to node_modules/@prisma/client which
// works everywhere with standard imports.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// ──────────────────────────────────────────────
// Thinking Map
//
// Three models carry the whole product. A ThinkingMap is one session of
// thinking; Messages are the conversation view of it; MapNodes are the
// visual view of the same thinking. The conversation and the map are two
// renderings of one process, so they hang off the same root.
//
// SQLite has no enum support in Prisma, so `kind`, `phase`, and `status`
// are Strings. Their allowed values live in app/lib/mapKinds.ts, which is
// the single place they are defined.
// ──────────────────────────────────────────────

model ThinkingMap {
  id       String @id @default(cuid())
  /// Short label for the map, shown when returning to a saved session.
  title    String
  /// The user's original unstructured input, preserved verbatim. Even after
  /// the direction changes, the seed idea is never overwritten.
  seedIdea String
  /// Which stage of the loop this map has reached:
  /// idea | deconstruct | map | research | explore | next-steps
  phase    String @default("idea")
  /// Monotonic change counter, bumped once per committed change in the same
  /// transaction as the write. This is the cursor an agent reads with, and the
  /// only shared notion of "now" across all three front doors. It is a column
  /// rather than an in-memory counter precisely because the stdio MCP server
  /// runs in a different process from Next — a process-local counter would
  /// hand two front doors two different answers.
  revision Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]
  nodes    MapNode[]
  themes   Theme[]
  events   MapEvent[]
}

// ──────────────────────────────────────────────
// Themes — the galaxies
//
// A theme is a group of questions that belong together ("Context", "Who it is
// for"). Themes are NOT a fixed vocabulary: which groupings an idea falls into
// is a property of that idea, so the agent names them as it discovers them.
//
// The hue is the exception. The agent supplies a label and the app assigns the
// colour, because colour is the navigation affordance on the board — you find
// your way around the galaxy by it — and that only works if the hues stay
// mutually distinguishable however many themes appear. Left to a model, two
// consecutive themes eventually land on two neighbouring blues.
// ──────────────────────────────────────────────

model Theme {
  id    String      @id @default(cuid())
  mapId String
  map   ThinkingMap @relation(fields: [mapId], references: [id], onDelete: Cascade)
  /// What the agent called this galaxy. Free text, shown as the cluster label.
  label String
  /// 0–359, assigned by the app on the golden angle. See app/lib/themeHue.ts.
  hue   Int
  /// Position among sibling themes, which is also the order they were opened.
  order Int         @default(0)

  createdAt DateTime @default(now())

  nodes MapNode[]

  @@index([mapId])
}

model Message {
  id      String      @id @default(cuid())
  mapId   String
  map     ThinkingMap @relation(fields: [mapId], references: [id], onDelete: Cascade)
  /// user | assistant
  role    String
  /// user | agent — who actually produced this turn. Distinct from `role`,
  /// which is the chat transcript position the model sees.
  origin  String @default("agent")
  content String

  createdAt DateTime @default(now())

  @@index([mapId])
}

model MapNode {
  id       String      @id @default(cuid())
  mapId    String
  map      ThinkingMap @relation(fields: [mapId], references: [id], onDelete: Cascade)
  /// Null for the root idea node. The map is a tree, so parentage is the
  /// only edge we need to store.
  parentId String?
  parent   MapNode?    @relation("NodeChildren", fields: [parentId], references: [id])
  children MapNode[]   @relation("NodeChildren")

  /// What this node represents. One of:
  /// idea | user | problem | goal | constraint | assumption | open-question
  /// | research | finding | gap | approach | pro | risk
  /// | known | unknown | direction | next-step
  kind      String
  /// The short text shown inside the node pill.
  label     String
  /// Longer supporting text, shown when the node is inspected. For an answered
  /// question this is what the person said.
  detail    String?
  /// For a question: the options offered, as a JSON array of strings. Null
  /// means the question is open-ended. Stored as JSON rather than as a relation
  /// because choices have no identity of their own — they are part of how one
  /// question is phrased, and nothing ever needs to link to a single option.
  choices   String?
  /// open | answered | updated — drives the dashed / solid / highlighted
  /// node treatment in the mockups.
  status    String  @default("open")
  /// Where a research finding came from, when this node is a finding.
  sourceUrl String?
  /// Left-to-right position among siblings.
  order     Int     @default(0)
  /// The galaxy this node belongs to. Null for the root idea, which belongs to
  /// no theme precisely because it is what every theme orbits.
  themeId   String?
  theme     Theme?  @relation(fields: [themeId], references: [id], onDelete: SetNull)
  /// user | agent. Without this an agent re-reading the map cannot tell its
  /// own writes from the person's, and will re-ingest its own output as new
  /// information. It is also what lets the UI mark what the person contributed.
  origin    String  @default("agent")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([mapId])
  @@index([parentId])
}

// ──────────────────────────────────────────────
// The exchange log
//
// WebMCP is pull-only: a page cannot wake an agent, and there is no push
// channel. So the give-and-take between the person and the agent has to be
// built out of a durable, ordered, resumable record that either side can read
// at any time — which is this table.
//
// One append-only log rather than three mechanisms, because the agent's
// delta, the inbox of unread user contributions, and the activity feed the UI
// renders are the same question asked three ways: "what happened after
// revision N?". It also covers node deletion, which a diff over MapNode rows
// cannot see at all.
// ──────────────────────────────────────────────

model MapEvent {
  id    String      @id @default(cuid())
  mapId String
  map   ThinkingMap @relation(fields: [mapId], references: [id], onDelete: Cascade)

  /// The map revision this event created. Ordered and gapless per map, so a
  /// reader that has seen revision N can ask for everything after it.
  revision Int
  /// node.added | node.updated | phase.set | agent.note
  /// | question.asked | user.answer | user.note | user.node
  kind     String
  /// user | agent — which side of the exchange produced this.
  origin   String
  /// Event-specific JSON. Kept as a string because SQLite has no JSON column
  /// type; the shapes live in app/lib/exchange.ts.
  payload  String
  /// Idempotency key, carried by EVERY row a single call wrote. A retried tool
  /// call with the same requestId is a no-op that returns the original batch
  /// and its last revision, rather than a duplicate write.
  ///
  /// Keyed per row rather than per batch because the retry needs the batch's
  /// extent: with only the first row keyed, a retry hands back the first
  /// revision as the resume cursor and the agent re-reads the rest of its own
  /// batch as new information. Uniqueness therefore includes `revision` — the
  /// duplicate a retry could create is caught by the in-transaction lookup in
  /// `recordEvents`, which runs inside SQLite's serialized write lock.
  requestId String?

  createdAt DateTime @default(now())

  @@unique([mapId, revision])
  @@unique([mapId, requestId, revision])
  @@index([mapId, revision])
  @@index([mapId, requestId])
}
