  "thinkingMap": [
    {
      "id": "map-sprawl",
      "title": "A platform that helps small clinics coordinate follow-up care",
      "seedIdea": "I keep hearing that small clinics lose track of follow-up care, and I think there's something to build there, but every time I try to describe it I end up describing an EHR.",
      "phase": "explore",
      "revision": 22
    }
  ],
  "message": [
    {
      "id": "sm-1",
      "mapId": "map-sprawl",
      "role": "user",
      "content": "I keep hearing that small clinics lose track of follow-up care, and I think there's something to build there, but every time I try to describe it I end up describing an EHR.",
      "origin": "user"
    },
    {
      "id": "sm-2",
      "mapId": "map-sprawl",
      "role": "assistant",
      "content": "Interesting - and the fact that you keep landing on an EHR is itself information. Before we go near a product shape, three things I'd like to understand:\nWho inside the clinic feels this pain first?\nIs this a coordination problem or a staffing problem wearing a coordination costume?\nAnd what happens today when a follow-up gets missed?",
      "origin": "agent"
    }
  ],
